#!name=GLaDOS 自动签到
#!desc=验证已登录的账号状态后保存 Cookie 与 User-Agent，定时签到并显示积分余额与各档兑换进度
#!system=ios

[Script]
# 默认每天 09:10 运行（使用设备本地时区，可自行改 cron 表达式）
# 总超时参考值：20 个编号账号 ×（3 次请求 × 默认 5 秒 + 最多 2 秒间隔）约 340 秒，再留约 25% 执行余量。
# timeout=430 是可调整的项目配置；批量账号超过 20 个时按数量增大。脚本完成后立即退出。
GLaDOS_Checkin = type=cron,cronexp="10 9 * * *",script-path=https://raw.githubusercontent.com/zxc-1/Scripts/refs/heads/main/Surge/glados.surge.js, timeout=430, wake-system=true
GLaDOS_Capture = type=http-response,pattern=^https:\/\/glados\.(network|cloud|one)\/api\/user\/status(?:\?.*)?$,requires-body=true,full-header-mode=true,script-path=https://raw.githubusercontent.com/zxc-1/Scripts/refs/heads/main/Surge/glados.surge.js

[MITM]
# 启用 Surge MITM 并信任其证书；同时更新模块与脚本，登录并刷新控制台后才保存会话。
hostname = %APPEND% glados.network, glados.cloud, glados.one
