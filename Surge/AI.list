# AI Combined Ruleset (Surge RULE-SET format)
# Merged from:
#   - https://kelee.one/Tool/Loon/Lsr/AI.lsr
#   - https://ruleset.skk.moe/List/non_ip/ai.conf
# Generated: 2026-06-19  (deduplicated, DOMAIN-SUFFIX preferred over DOMAIN on conflict)
# Usage in Surge [Rule]:  RULE-SET,/Users/dala/Desktop/AI.list,PROXY
#########################################

# ===== OpenAI / ChatGPT =====
DOMAIN-SUFFIX,openai.com
DOMAIN-SUFFIX,chatgpt.com
DOMAIN-SUFFIX,chat.com
DOMAIN-SUFFIX,sora.com
DOMAIN-SUFFIX,oaistatic.com
DOMAIN-SUFFIX,oaiusercontent.com
DOMAIN-SUFFIX,crixet.com
DOMAIN-SUFFIX,ai.com
DOMAIN-KEYWORD,openai
DOMAIN,chatgpt.livekit.cloud
DOMAIN,host.livekit.cloud
DOMAIN,turn.livekit.cloud
DOMAIN,openai.com.cdn.cloudflare.net
DOMAIN,openaiapi-site.azureedge.net
DOMAIN,openaicomproductionae4b.blob.core.windows.net
DOMAIN,production-openaicom-storage.azureedge.net
DOMAIN,openaicom.imgix.net
AND,((DOMAIN-KEYWORD,chatgpt-async-webps-prod-),(DOMAIN-SUFFIX,webpubsub.azure.com))
AND,((DOMAIN-KEYWORD,openaicom-api-),(DOMAIN-SUFFIX,azurefd.net))

# ===== Anthropic / Claude =====
DOMAIN-SUFFIX,anthropic.com
DOMAIN-SUFFIX,claude.ai
DOMAIN-SUFFIX,claude.com
DOMAIN-SUFFIX,claudeusercontent.com
IP-CIDR,160.79.104.0/23,no-resolve
IP-CIDR6,2607:6bc0::/48,no-resolve

